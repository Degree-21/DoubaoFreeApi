 {
  "manifest_version": 3,
  "name": "21-Doubao-API-Monitor",
  "version": "1.0",
  "description": "Monitor Doubao chat requests and extract session data",
  "permissions": [
    "storage",
    "activeTab",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "https://www.doubao.com/*",
    "http://localhost:8001/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Doubao API Monitor"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.doubao.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["https://www.doubao.com/*"]
    }
  ]
}